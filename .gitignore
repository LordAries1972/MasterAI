# CMake build trees and generated build-system files
/build/
/bin/
/obj/
/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
build.ninja
.ninja_deps
.ninja_log
Testing/

# Compiled binaries, libraries, objects, and debug symbols
*.a
*.app
*.dll
*.dylib
*.exe
*.ilk
*.lib
*.o
*.obj
*.pdb
*.so
*.so.*

# Local model payloads. Keep the repository-owned layout and schema.
/models/**
!/models/**/
!/models/**/.keep
!/models/manifest.schema.json

# Local server instance: settings (host-specific paths), encrypted secrets,
# and all generated runtime data (record store, sessions, audit log, logs).
/config/
/runtime/

# Locally generated certificate/key material (TLS certs, SSH host keys).
# Already covered by /config/ above, but listed explicitly so these can
# never be pushed to GitHub even if regenerated somewhere else.
/config/certificates/
*.pem
*.key
*_host_key*

# Large downloaded payloads, archives, and interrupted transfers
*.7z
*.bin
*.ckpt
*.ggml
*.gguf
*.gz
*.onnx
*.part
*.partial
*.pt
*.pth
*.safetensors
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
*.tmp
*.zip
*.zst

# Common editor and operating-system debris
.DS_Store
Thumbs.db
*.suo
*.user
*.VC.db
*.VC.VC.opendb

