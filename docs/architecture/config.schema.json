{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterai.local/schemas/config-v1.json",
  "title": "MasterAI configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "server", "tls", "auth", "workspace", "models"],
  "properties": {
    "schemaVersion": {"const": 1},
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "port", "allowIntranet", "maxRequestBytes",
        "requestTimeoutSeconds", "maxConcurrentConnections",
        "rateLimitPerMinute", "allowedHosts", "allowedOrigins"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "allowIntranet": {"type": "boolean"},
        "maxRequestBytes": {"type": "integer", "minimum": 1024, "maximum": 67108864},
        "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "maxConcurrentConnections": {"type": "integer", "minimum": 1, "maximum": 1024},
        "rateLimitPerMinute": {"type": "integer", "minimum": 1, "maximum": 100000},
        "allowedHosts": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "allowedOrigins": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "certificateFile", "privateKeyFile"],
      "properties": {
        "mode": {"enum": ["disabled-loopback-only", "required"]},
        "certificateFile": {"type": "string"},
        "privateKeyFile": {"type": "string"}
      },
      "$comment": "certificateFile/privateKeyFile must both be non-empty, existing regular files whenever server.host is non-loopback or mode is 'required' -- a cross-field/filesystem check ConfigurationManager::validate() enforces at load time, not representable as a plain per-property schema constraint."
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "sessionMinutes"],
      "properties": {
        "enabled": {"const": true},
        "sessionMinutes": {"type": "integer", "minimum": 1, "maximum": 10080},
        "allowLocalPasswordAccounts": {"type": "boolean"},
        "allowOsIdentityAccounts": {"type": "boolean"}
      },
      "$comment": "At least one of allowLocalPasswordAccounts (default true) or allowOsIdentityAccounts (default false) must remain true -- enforced by ConfigurationManager::validate(), not expressible per-property here."
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimeRoot", "modelsRoot"],
      "properties": {
        "runtimeRoot": {"type": "string", "minLength": 1},
        "modelsRoot": {"type": "string", "minLength": 1}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["pageFileRoot"],
      "properties": {
        "pageFileRoot": {"type": "string"}
      },
      "$comment": "pageFileRoot ('PageFile' in the web UI settings): a directory MasterAI uses as a substitute for the system pagefile/temp area for its own disk-backed cache and scratch data, isolated to MasterAI's own use and requiring no admin privileges. Empty (the default) falls back to workspace.runtimeRoot/'cache'. Restart required after changing -- see resolve_page_file_root() and ConfigurationManager::validate()."
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["memoryReserveMiB"],
      "properties": {
        "memoryReserveMiB": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["llamaServerExecutable", "runnerPort"],
      "properties": {
        "llamaServerExecutable": {"type": "string"},
        "runnerPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "chatMaxReplyTokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "chatContextLength": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "startupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "stallTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      },
      "$comment": "runnerPort must also differ from server.port -- a cross-field check ConfigurationManager::validate() enforces, not representable per-property here. chatMaxReplyTokens/chatContextLength/startupTimeoutSeconds default to 8192/4096/120 respectively when omitted -- see docs/architecture/configuration.md. stallTimeoutSeconds (default 120) bounds how long a live generation may go without receiving a byte from the runner before it is treated as hung."
    },
    "downloads": {
      "type": "object", "additionalProperties": false,
      "required": ["curlExecutable"],
      "properties": {
        "curlExecutable": {"type": "string"}
      }
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "parquetHelperExecutable": {"type": "string"},
        "maximumDocumentBytes": {"type": "integer", "minimum": 1, "maximum": 268435456}
      },
      "$comment": "Both fields are optional and default to '' (Parquet ingestion disabled) and 26214400 (25 MiB) respectively when the section or field is omitted -- see docs/architecture/configuration.md."
    },
    "indexing": {
      "type": "object", "additionalProperties": false,
      "required": ["watchProjectFiles"],
      "properties": {
        "watchProjectFiles": {"type": "boolean"}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "deadlineMilliseconds", "maximumContextBytes",
        "maximumChunksPerSource", "maximumTotalChunks"],
      "properties": {
        "enabled": {"type": "boolean"},
        "deadlineMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
        "maximumContextBytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "maximumChunksPerSource": {"type": "integer", "minimum": 1, "maximum": 256},
        "maximumTotalChunks": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "maximumBytesPerCategory"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maximumBytesPerCategory": {"type": "integer", "minimum": 1, "maximum": 4294967296}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "maxSlots", "idleRetentionSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSlots": {"type": "integer", "minimum": 1, "maximum": 64},
        "idleRetentionSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": ["autoTune"],
      "properties": {
        "autoTune": {"type": "boolean"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["hardLimitMiB", "minimumFreePercent", "criticalPressurePercent", "profile"],
      "properties": {
        "hardLimitMiB": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "minimumFreePercent": {"type": "integer", "minimum": 1, "maximum": 50},
        "criticalPressurePercent": {"type": "integer", "minimum": 80, "maximum": 99},
        "profile": {"enum": ["minimal", "balanced", "performance"]}
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["acceleratorPolicy"],
      "properties": {
        "acceleratorPolicy": {"enum": ["auto", "cpu_only", "gpu_allowed"]}
      },
      "$comment": "Phase 30A. 'cpu_only' forces zero GPU layers, CPU KV placement, and a GPU-hiding runner process environment; conflicting saved/CLI/API/environment/calibrated GPU-layer requests are rejected rather than silently overridden -- see CalibrationService::resolve() and LlamaCppAdapter::build_launch_spec() in src/calibration.cpp / src/models.cpp. Defaults to 'auto' when the section is omitted."
    }
  }
}
