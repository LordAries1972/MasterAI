{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterai.local/schemas/config-v1.json",
  "title": "MasterAI configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "server", "tls", "auth", "workspace", "models"],
  "properties": {
    "schemaVersion": {"const": 1},
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "port", "allowIntranet", "maxRequestBytes",
        "requestTimeoutSeconds", "maxConcurrentConnections",
        "rateLimitPerMinute", "allowedHosts", "allowedOrigins"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "allowIntranet": {"type": "boolean"},
        "maxRequestBytes": {"type": "integer", "minimum": 1024, "maximum": 67108864},
        "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "maxConcurrentConnections": {"type": "integer", "minimum": 1, "maximum": 1024},
        "rateLimitPerMinute": {"type": "integer", "minimum": 1, "maximum": 100000},
        "allowedHosts": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "allowedOrigins": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "certificateFile", "privateKeyFile"],
      "properties": {
        "mode": {"enum": ["disabled-loopback-only", "required"]},
        "certificateFile": {"type": "string"},
        "privateKeyFile": {"type": "string"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "sessionMinutes"],
      "properties": {
        "enabled": {"const": true},
        "sessionMinutes": {"type": "integer", "minimum": 1, "maximum": 10080}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimeRoot", "modelsRoot"],
      "properties": {
        "runtimeRoot": {"type": "string", "minLength": 1},
        "modelsRoot": {"type": "string", "minLength": 1}
      }
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["memoryReserveMiB"],
      "properties": {
        "memoryReserveMiB": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["llamaServerExecutable", "runnerPort"],
      "properties": {
        "llamaServerExecutable": {"type": "string"},
        "runnerPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "downloads": {
      "type": "object", "additionalProperties": false,
      "required": ["curlExecutable"],
      "properties": {
        "curlExecutable": {"type": "string"}
      }
    }
  }
}
