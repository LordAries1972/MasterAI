{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterai.local/schemas/model-manifest-v1.json",
  "title": "MasterAI verified model manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "category", "model",
    "requirements", "files", "backends", "provenance", "license", "hardware"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 160},
    "category": {"enum": ["general-programming", "code-completion", "code-review",
      "debugging", "documentation", "embeddings-code-search"]},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "architecture", "quantization"],
      "properties": {
        "format": {"const": "gguf"},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 96},
        "quantization": {"type": "string", "minLength": 1, "maxLength": 48}
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumRamMiB", "recommendedRamMiB", "estimatedDiskMiB"],
      "properties": {
        "minimumRamMiB": {"type": "integer", "minimum": 1},
        "recommendedRamMiB": {"type": "integer", "minimum": 1},
        "estimatedDiskMiB": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 255},
          "sizeBytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "backends": {"type": "array", "minItems": 1, "maxItems": 1,
      "items": {"const": "llama-cpp"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceUrl", "revision"],
      "properties": {
        "sourceUrl": {"type": "string", "pattern": "^https://(huggingface\\.co|github\\.com)/"},
        "revision": {"type": "string", "minLength": 7, "maxLength": 128}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "accepted"],
      "properties": {
        "spdx": {"enum": ["Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause",
          "CC-BY-4.0", "Llama-3.1", "Llama-3.2", "Gemma"]},
        "accepted": {"const": true}
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["cpuFeatures", "gpuBackend"],
      "properties": {
        "cpuFeatures": {"type": "array", "uniqueItems": true,
          "items": {"enum": ["sse4.2", "avx", "avx2", "neon"]}},
        "gpuBackend": {"enum": ["", "cuda", "vulkan", "hip"]}
      }
    }
  }
}
